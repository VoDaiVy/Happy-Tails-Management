# ========================================
# Happy Tails Management - Backend
# Environment Configuration
# ========================================

# ==================== Application ====================
NODE_ENV=development
PORT=3001

# ==================== MongoDB ====================
# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://tranplhde180959_db_user:huyentran@cluster0.bjm0nhs.mongodb.net/happy_tails_db?retryWrites=true&w=majority&appName=Cluster0

# ==================== JWT Authentication ====================
# Secret keys - Use strong random strings in production (minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=happytails_super_secret_key_2026_production_ready_32chars
JWT_REFRESH_SECRET=happytails_refresh_secret_key_2026_production_ready

# Token expiration
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d
JWT_COOKIE_EXPIRE=7

# ==================== Security ====================
# Password hashing rounds (higher = more secure but slower)
BCRYPT_ROUNDS=12

# Account lockout settings
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=7200000

# ==================== Rate Limiting ====================
# Time window in milliseconds (15 minutes = 900000)
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# ==================== Email Configuration ====================
# SMTP settings (Gmail example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=hosyhung419@gmail.com
EMAIL_PASS=mlvbztzsbrxdcyli


# Sender information
EMAIL_FROM=Happy Tails <hosyhung419@gmail.com>

# ==================== Frontend URL ====================
# Used for email links (verification, password reset)
FRONTEND_URL=http://localhost:5173

# ==================== Logging ====================
# Log level: ERROR, WARN, INFO, DEBUG
LOG_LEVEL=INFO
