/**
 * Wallet Service
 * Business logic for wallet operations with ACID transaction support
 */

const mongoose = require('mongoose');
const Wallet = require('../models/Wallet');
const Transaction = require('../models/Transaction');
const Cart = require('../models/Cart');
const Order = require('../models/Order');
const User = require('../models/User');
const Service = require('../models/Service');
const payosService = require('./payos.service');
const { createError } = require('../utils/AppError');
const logger = require('../utils/logger');

/**
 * Get wallet for user (creates if not exists)
 * @param {ObjectId} userId - User ID
 * @returns {Promise<Object>} Wallet data
 */
const getWallet = async (userId) => {
  const wallet = await Wallet.findByUser(userId);
  
  return {
    _id: wallet._id,
    userId: wallet.userId,
    balance: wallet.balance,
    currency: wallet.currency,
    totalDeposited: wallet.totalDeposited,
    totalWithdrawn: wallet.totalWithdrawn,
    totalSpent: wallet.totalSpent,
    isLocked: wallet.isLocked,
    updatedAt: wallet.updatedAt
  };
};

/**
 * Initiate a deposit to wallet
 * @param {ObjectId} userId - User ID
 * @param {Object} data - Deposit data { amount, method, note }
 * @returns {Promise<Object>} Deposit result
 */
const initiateDeposit = async (userId, { amount, method, note }) => {
  const wallet = await Wallet.findByUser(userId);
  const user = await User.findById(userId);
  
  if (!user) {
    throw createError.notFound('User not found', 'USER_NOT_FOUND');
  }
  
  if (wallet.isLocked) {
    throw createError.badRequest('Wallet is locked. Contact support.', 'WALLET_LOCKED');
  }
  
  // CASE 1: Internal deposit (admin/test use)
  if (method === 'internal') {
    const session = await mongoose.startSession();
    
    try {
      let result;
      
      await session.withTransaction(async () => {
        const balanceBefore = wallet.balance;
        
        // Update wallet balance
        wallet.deposit(amount);
        await wallet.save({ session });
        
        // Create completed transaction record
        const [transaction] = await Transaction.create([{
          transactionCode: Transaction.generateCode(),
          userId,
          walletId: wallet._id,
          type: 'deposit',
          method: 'internal',
          status: 'completed',
          amount,
          balanceBefore,
          balanceAfter: wallet.balance,
          note: note || 'Internal deposit'
        }], { session });
        
        result = {
          wallet: {
            balance: wallet.balance,
            totalDeposited: wallet.totalDeposited
          },
          transaction: {
            transactionCode: transaction.transactionCode,
            amount: transaction.amount,
            status: transaction.status
          }
        };
      });
      
      await session.endSession();
      
      logger.info(`Internal deposit completed: userId=${userId}, amount=${amount}`);
      return {
        ...result,
        message: 'Deposit successful'
      };
      
    } catch (error) {
      await session.endSession();
      logger.error(`Internal deposit failed: ${error.message}`);
      throw error;
    }
  }
  
  // CASE 2: PayOS deposit
  if (method === 'payos') {
    const paymentResult = await payosService.createPaymentLink({
      userId,
      walletId: wallet._id,
      amount,
      note,
      user,
      wallet
    });
    
    logger.info(`PayOS deposit initiated: userId=${userId}, orderCode=${paymentResult.orderCode}`);
    
    return {
      checkoutUrl: paymentResult.checkoutUrl,
      orderCode: paymentResult.orderCode,
      transactionCode: paymentResult.transactionCode,
      amount: paymentResult.amount,
      expiredAt: paymentResult.expiredAt,
      message: 'Payment link created. Redirect user to checkoutUrl.'
    };
  }
  
  throw createError.badRequest('Invalid payment method', 'INVALID_METHOD');
};

/**
 * Handle PayOS webhook callback
 * @param {Object} webhookBody - Raw webhook body from PayOS
 * @returns {Promise<Object>} Processing result
 */
const handlePayOSWebhook = async (webhookBody) => {
  // Step 1: Verify webhook signature
  let verifiedData;
  try {
    verifiedData = payosService.verifyWebhookData(webhookBody);
  } catch (error) {
    logger.error(`Webhook verification failed: ${error.message}`);
    throw createError.badRequest('Invalid webhook signature', 'INVALID_WEBHOOK');
  }
  
  // Step 2: Extract data
  const { orderCode, code, desc } = verifiedData;
  const status = code === '00' ? 'PAID' : (desc || 'FAILED');
  const amount = verifiedData.amount || webhookBody.data?.amount;
  
  logger.info(`PayOS webhook received: orderCode=${orderCode}, status=${status}`);
  
  // Step 3: Find pending transaction
  const transaction = await Transaction.findOne({
    payosOrderCode: orderCode,
    status: 'pending',
    type: 'deposit'
  });
  
  if (!transaction) {
    // Already processed or not found - return success for idempotency
    logger.info(`Transaction already processed or not found: orderCode=${orderCode}`);
    return { received: true, message: 'Already processed' };
  }
  
  // Step 4: Handle by status
  if (status === 'PAID' || code === '00') {
    const session = await mongoose.startSession();
    
    try {
      await session.withTransaction(async () => {
        // Get wallet with session
        const wallet = await Wallet.findById(transaction.walletId).session(session);
        
        if (!wallet) {
          throw new Error('Wallet not found');
        }
        
        const balanceBefore = wallet.balance;
        
        // Update wallet balance
        wallet.deposit(transaction.amount);
        await wallet.save({ session });
        
        // Update transaction status
        transaction.status = 'completed';
        transaction.balanceBefore = balanceBefore;
        transaction.balanceAfter = wallet.balance;
        transaction.metadata = {
          ...transaction.metadata,
          webhookData: webhookBody
        };
        await transaction.save({ session });
      });
      
      await session.endSession();
      
      logger.info(`PayOS deposit completed: orderCode=${orderCode}, amount=${transaction.amount}`);
      return { received: true, status: 'completed' };
      
    } catch (error) {
      await session.endSession();
      logger.error(`PayOS webhook processing failed: ${error.message}`);
      throw error;
    }
  }
  
  // Handle CANCELLED or EXPIRED
  if (status === 'CANCELLED' || status === 'EXPIRED' || code !== '00') {
    transaction.status = 'cancelled';
    transaction.failureReason = status;
    transaction.metadata = {
      ...transaction.metadata,
      webhookData: webhookBody
    };
    await transaction.save();
    
    logger.info(`PayOS deposit cancelled: orderCode=${orderCode}, reason=${status}`);
    return { received: true, status: 'cancelled' };
  }
  
  return { received: true };
};

/**
 * Request withdrawal from wallet
 * @param {ObjectId} userId - User ID
 * @param {Object} data - Withdrawal data
 * @returns {Promise<Object>} Withdrawal result
 */
const withdraw = async (userId, { amount, bankName, bankAccountNumber, bankAccountName, note }) => {
  const wallet = await Wallet.findOne({ userId });
  
  if (!wallet) {
    throw createError.notFound('Wallet not found. Please deposit first.', 'WALLET_NOT_FOUND');
  }
  
  if (wallet.isLocked) {
    throw createError.badRequest('Wallet is locked. Contact support.', 'WALLET_LOCKED');
  }
  
  if (wallet.balance < amount) {
    throw createError.badRequest('Insufficient balance', 'INSUFFICIENT_BALANCE');
  }
  
  const session = await mongoose.startSession();
  
  try {
    let result;
    
    await session.withTransaction(async () => {
      const balanceBefore = wallet.balance;
      
      // Deduct from wallet
      wallet.deduct(amount);
      await wallet.save({ session });
      
      // Create pending withdrawal transaction
      const bankInfo = `${bankName} - ${bankAccountNumber} - ${bankAccountName}`;
      const [transaction] = await Transaction.create([{
        transactionCode: Transaction.generateCode(),
        userId,
        walletId: wallet._id,
        type: 'withdraw',
        method: 'bank_transfer',
        status: 'pending', // Will be processed by admin
        amount,
        balanceBefore,
        balanceAfter: wallet.balance,
        note: `${bankInfo}${note ? ' | ' + note : ''}`
      }], { session });
      
      result = {
        wallet: {
          balance: wallet.balance,
          totalWithdrawn: wallet.totalWithdrawn
        },
        transaction: {
          transactionCode: transaction.transactionCode,
          amount: transaction.amount,
          status: transaction.status
        }
      };
    });
    
    await session.endSession();
    
    logger.info(`Withdrawal requested: userId=${userId}, amount=${amount}`);
    return {
      ...result,
      message: 'Withdrawal request submitted. Processing within 1-3 business days.'
    };
    
  } catch (error) {
    await session.endSession();
    logger.error(`Withdrawal request failed: ${error.message}`);
    
    if (error.message === 'Insufficient balance') {
      throw createError.badRequest('Insufficient balance', 'INSUFFICIENT_BALANCE');
    }
    if (error.message === 'Wallet is locked') {
      throw createError.badRequest('Wallet is locked. Contact support.', 'WALLET_LOCKED');
    }
    
    throw error;
  }
};

/**
 * Get transaction history for user
 * @param {ObjectId} userId - User ID
 * @param {Object} query - Query params
 * @returns {Promise<Object>} Transactions with pagination
 */
const getTransactions = async (userId, query = {}) => {
  const {
    type,
    status,
    method,
    from,
    to,
    page = 1,
    limit = 10,
    sortBy = 'createdAt',
    sortOrder = 'desc'
  } = query;
  
  // Build filter
  const filter = { userId };
  
  if (type) filter.type = type;
  if (status) filter.status = status;
  if (method) filter.method = method;
  
  if (from || to) {
    filter.createdAt = {};
    if (from) filter.createdAt.$gte = new Date(from);
    if (to) filter.createdAt.$lte = new Date(to);
  }
  
  // Calculate pagination
  const skip = (page - 1) * limit;
  const sort = { [sortBy]: sortOrder === 'desc' ? -1 : 1 };
  
  // Execute queries
  const [transactions, total] = await Promise.all([
    Transaction.find(filter)
      .sort(sort)
      .skip(skip)
      .limit(limit)
      .select('-metadata -__v'),
    Transaction.countDocuments(filter)
  ]);
  
  return {
    data: transactions,
    pagination: {
      page: parseInt(page),
      limit: parseInt(limit),
      total,
      totalPages: Math.ceil(total / limit)
    }
  };
};

/**
 * ACID Checkout with Wallet
 * Complete 6-step transactional checkout flow
 * @param {ObjectId} userId - User ID
 * @param {Object} data - Checkout data { note, scheduledAt }
 * @returns {Promise<Object>} Order, transaction, and wallet balance
 */
const checkoutWithWallet = async (userId, { note, scheduledAt }) => {
  // Step 1: Start MongoDB session for ACID transaction
  const session = await mongoose.startSession();
  
  let order;
  let transaction;
  let wallet;
  
  try {
    await session.withTransaction(async () => {
      // Step 2: Get Cart and calculate total
      const cart = await Cart.findOne({ userId }).session(session);
      
      if (!cart || !cart.items || cart.items.length === 0) {
        throw createError.badRequest('Cart is empty', 'EMPTY_CART');
      }
      
      // Validate cart items - check service availability
      const serviceIds = cart.items.map(item => item.serviceId);
      const services = await Service.find({ _id: { $in: serviceIds } }).session(session);
      const serviceMap = new Map(services.map(s => [s._id.toString(), s]));
      
      const unavailableServices = [];
      for (const item of cart.items) {
        const service = serviceMap.get(item.serviceId.toString());
        if (!service || !service.isActive) {
          unavailableServices.push(item.name);
        }
      }
      
      if (unavailableServices.length > 0) {
        throw createError.badRequest(
          `Some services are no longer available: ${unavailableServices.join(', ')}`,
          'SERVICE_UNAVAILABLE'
        );
      }
      
      // Step 3: Get Wallet and check balance
      wallet = await Wallet.findOne({ userId }).session(session);
      
      if (!wallet) {
        throw createError.badRequest('Wallet not found. Please deposit first.', 'WALLET_NOT_FOUND');
      }
      
      if (wallet.isLocked) {
        throw createError.badRequest('Wallet is locked. Contact support.', 'WALLET_LOCKED');
      }
      
      if (wallet.balance < cart.totalPrice) {
        const error = createError.badRequest('Insufficient wallet balance', 'INSUFFICIENT_BALANCE');
        error.details = {
          required: cart.totalPrice,
          available: wallet.balance,
          shortfall: cart.totalPrice - wallet.balance
        };
        throw error;
      }
      
      // Step 4: Deduct wallet balance and create transaction
      const balanceBefore = wallet.balance;
      
      wallet.spend(cart.totalPrice);
      await wallet.save({ session });
      
      // Create payment transaction
      const [txn] = await Transaction.create([{
        transactionCode: Transaction.generateCode(),
        userId,
        walletId: wallet._id,
        type: 'payment',
        method: 'internal',
        status: 'completed',
        amount: cart.totalPrice,
        balanceBefore,
        balanceAfter: wallet.balance,
        note: 'Payment for order'
      }], { session });
      
      transaction = txn;
      
      // Step 5: Create Order with cart snapshot
      const orderCode = `ORD-${Date.now()}-${Math.floor(1000 + Math.random() * 9000)}`;
      
      const orderItems = cart.items.map(item => ({
        serviceId: item.serviceId,
        name: item.name,
        price: item.price,
        duration: item.duration,
        imageUrl: item.imageUrl,
        quantity: item.quantity,
        subtotal: item.subtotal,
        note: item.note
      }));
      
      const [newOrder] = await Order.create([{
        orderCode,
        userId,
        items: orderItems,
        totalPrice: cart.totalPrice,
        totalItems: cart.totalItems,
        status: 'pending',
        paymentStatus: 'paid', // Paid via wallet
        paymentMethod: 'wallet',
        note: note || '',
        scheduledAt: scheduledAt || null
      }], { session });
      
      order = newOrder;
      
      // Update transaction with order reference
      transaction.referenceId = order._id.toString();
      await transaction.save({ session });
      
      // Step 6: Clear cart
      cart.items = [];
      cart.totalPrice = 0;
      cart.totalItems = 0;
      await cart.save({ session });
    });
    
    // Step 7: Commit successful (auto by withTransaction)
    await session.endSession();
    
    logger.info(`Checkout completed: userId=${userId}, orderCode=${order.orderCode}, amount=${order.totalPrice}`);
    
    return {
      order: {
        _id: order._id,
        orderCode: order.orderCode,
        status: order.status,
        paymentStatus: order.paymentStatus,
        paymentMethod: order.paymentMethod,
        totalPrice: order.totalPrice,
        totalItems: order.totalItems,
        items: order.items,
        scheduledAt: order.scheduledAt
      },
      transaction: {
        transactionCode: transaction.transactionCode,
        type: transaction.type,
        amount: transaction.amount,
        balanceBefore: transaction.balanceBefore,
        balanceAfter: transaction.balanceAfter,
        status: transaction.status
      },
      walletBalance: wallet.balance
    };
    
  } catch (error) {
    await session.endSession();
    
    // Log and re-throw appropriate error
    logger.error(`Checkout failed: ${error.message}`);
    
    // If it's already an AppError, re-throw
    if (error.isOperational) {
      throw error;
    }
    
    // Generic error for unexpected failures
    throw createError.internal(
      'Checkout failed. Your wallet has not been charged.',
      'CHECKOUT_FAILED'
    );
  }
};

/**
 * Handle PayOS return URL (user redirected after payment)
 * @param {Object} queryParams - URL query parameters
 * @returns {Promise<Object>} Transaction status
 */
const handlePayOSReturn = async (queryParams) => {
  const { orderCode, status, cancel } = queryParams;
  
  if (!orderCode) {
    throw createError.badRequest('Missing orderCode', 'MISSING_ORDER_CODE');
  }
  
  // Find transaction
  const transaction = await Transaction.findOne({
    payosOrderCode: parseInt(orderCode)
  });
  
  if (!transaction) {
    throw createError.notFound('Transaction not found', 'TRANSACTION_NOT_FOUND');
  }
  
  // If cancelled by user
  if (cancel === 'true' || status === 'CANCELLED') {
    if (transaction.status === 'pending') {
      transaction.status = 'cancelled';
      transaction.failureReason = 'User cancelled';
      await transaction.save();
      
      // Cancel PayOS payment link
      if (transaction.payosPaymentLinkId) {
        await payosService.cancelPaymentLink(transaction.payosPaymentLinkId);
      }
    }
    
    return {
      success: false,
      message: 'Payment was cancelled',
      transactionCode: transaction.transactionCode,
      status: 'cancelled'
    };
  }
  
  // Payment successful - webhook should have already processed
  // Just return status
  return {
    success: transaction.status === 'completed',
    message: transaction.status === 'completed' 
      ? 'Payment successful' 
      : 'Payment is being processed',
    transactionCode: transaction.transactionCode,
    status: transaction.status,
    amount: transaction.amount
  };
};

/**
 * Handle PayOS cancel URL (user cancelled payment)
 * @param {Object} queryParams - URL query parameters
 * @returns {Promise<Object>} Cancellation result
 */
const handlePayOSCancel = async (queryParams) => {
  const { orderCode } = queryParams;
  
  if (!orderCode) {
    throw createError.badRequest('Missing orderCode', 'MISSING_ORDER_CODE');
  }
  
  // Find pending transaction
  const transaction = await Transaction.findOne({
    payosOrderCode: parseInt(orderCode),
    status: 'pending'
  });
  
  if (!transaction) {
    return {
      success: true,
      message: 'Transaction already processed or not found'
    };
  }
  
  // Update transaction status
  transaction.status = 'cancelled';
  transaction.failureReason = 'User cancelled';
  await transaction.save();
  
  // Cancel PayOS payment link
  if (transaction.payosPaymentLinkId) {
    await payosService.cancelPaymentLink(transaction.payosPaymentLinkId);
  }
  
  logger.info(`Payment cancelled by user: orderCode=${orderCode}`);
  
  return {
    success: true,
    message: 'Payment cancelled successfully',
    transactionCode: transaction.transactionCode
  };
};

module.exports = {
  getWallet,
  initiateDeposit,
  handlePayOSWebhook,
  withdraw,
  getTransactions,
  checkoutWithWallet,
  handlePayOSReturn,
  handlePayOSCancel
};
