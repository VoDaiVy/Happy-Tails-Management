{
	"info": {
		"_postman_id": "tx-history-001",
		"name": "Happy Tails - Transaction History API",
		"description": "API endpoints for Transaction History feature (UC-26 & UC-39)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000/api"
		},
		{
			"key": "accessToken",
			"value": "your-jwt-token-here"
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{accessToken}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "User Transaction Endpoints (UC-26)",
			"item": [
				{
					"name": "Get My Transactions",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/wallet/transactions?page=1&limit=20&type=deposit&status=completed&from=2024-01-01&to=2024-12-31",
							"host": ["{{baseUrl}}"],
							"path": ["wallet", "transactions"],
							"query": [
								{
									"key": "page",
									"value": "1",
									"description": "Page number (default: 1)"
								},
								{
									"key": "limit",
									"value": "20",
									"description": "Items per page (default: 20, max: 100)"
								},
								{
									"key": "type",
									"value": "deposit",
									"description": "Filter by type: deposit | payment | refund"
								},
								{
									"key": "status",
									"value": "completed",
									"description": "Filter by status: pending | completed | failed | cancelled"
								},
								{
									"key": "from",
									"value": "2024-01-01",
									"description": "Start date (YYYY-MM-DD)"
								},
								{
									"key": "to",
									"value": "2024-12-31",
									"description": "End date (YYYY-MM-DD)"
								}
							]
						},
						"description": "Get current user's transaction history with filters and pagination"
					},
					"response": [
						{
							"name": "Success Response",
							"originalRequest": {
								"method": "GET",
								"url": {
									"raw": "{{baseUrl}}/wallet/transactions?page=1&limit=10",
									"host": ["{{baseUrl}}"],
									"path": ["wallet", "transactions"],
									"query": [
										{ "key": "page", "value": "1" },
										{ "key": "limit", "value": "10" }
									]
								}
							},
							"status": "OK",
							"code": 200,
							"body": "{\n  \"success\": true,\n  \"message\": \"Transactions fetched\",\n  \"data\": [\n    {\n      \"_id\": \"64abc123...\",\n      \"transactionCode\": \"TXN-1234567890\",\n      \"type\": \"deposit\",\n      \"method\": \"payos\",\n      \"amount\": 100000,\n      \"balanceBefore\": 0,\n      \"balanceAfter\": 100000,\n      \"status\": \"completed\",\n      \"createdAt\": \"2024-01-15T10:30:00.000Z\"\n    }\n  ],\n  \"pagination\": {\n    \"total\": 50,\n    \"page\": 1,\n    \"limit\": 10,\n    \"totalPages\": 5,\n    \"hasNextPage\": true,\n    \"hasPrevPage\": false\n  }\n}"
						}
					]
				},
				{
					"name": "Get My Transaction by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/wallet/transactions/:id",
							"host": ["{{baseUrl}}"],
							"path": ["wallet", "transactions", ":id"],
							"variable": [
								{
									"key": "id",
									"value": "64abc123def456789012abcd",
									"description": "Transaction ID (24-character hex string)"
								}
							]
						},
						"description": "Get a specific transaction detail (user can only see their own transactions)"
					},
					"response": [
						{
							"name": "Success Response",
							"status": "OK",
							"code": 200,
							"body": "{\n  \"success\": true,\n  \"message\": \"Transaction fetched successfully\",\n  \"data\": {\n    \"transaction\": {\n      \"_id\": \"64abc123...\",\n      \"transactionCode\": \"TXN-1234567890\",\n      \"type\": \"deposit\",\n      \"method\": \"payos\",\n      \"amount\": 100000,\n      \"balanceBefore\": 0,\n      \"balanceAfter\": 100000,\n      \"status\": \"completed\",\n      \"note\": \"Nạp tiền qua PayOS\",\n      \"wallet\": {\n        \"_id\": \"...\",\n        \"balance\": 100000\n      },\n      \"createdAt\": \"2024-01-15T10:30:00.000Z\"\n    }\n  }\n}"
						},
						{
							"name": "Not Found",
							"status": "Not Found",
							"code": 404,
							"body": "{\n  \"success\": false,\n  \"error\": {\n    \"code\": \"TRANSACTION_NOT_FOUND\",\n    \"message\": \"Transaction not found or you don't have access\"\n  }\n}"
						}
					]
				}
			]
		},
		{
			"name": "Admin Transaction Endpoints (UC-39)",
			"item": [
				{
					"name": "Get All System Transactions",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/admin/transactions?page=1&limit=20&type=deposit&status=completed&method=payos&from=2024-01-01&to=2024-12-31&minAmount=10000&maxAmount=1000000&userId=64abc123def456789012abcd",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "transactions"],
							"query": [
								{
									"key": "page",
									"value": "1",
									"description": "Page number (default: 1)"
								},
								{
									"key": "limit",
									"value": "20",
									"description": "Items per page (default: 20, max: 100)"
								},
								{
									"key": "type",
									"value": "deposit",
									"description": "Filter by type: deposit | payment | refund"
								},
								{
									"key": "status",
									"value": "completed",
									"description": "Filter by status: pending | completed | failed | cancelled"
								},
								{
									"key": "method",
									"value": "payos",
									"description": "Filter by method: payos | system"
								},
								{
									"key": "from",
									"value": "2024-01-01",
									"description": "Start date (YYYY-MM-DD)"
								},
								{
									"key": "to",
									"value": "2024-12-31",
									"description": "End date (YYYY-MM-DD)"
								},
								{
									"key": "minAmount",
									"value": "10000",
									"description": "Minimum amount filter"
								},
								{
									"key": "maxAmount",
									"value": "1000000",
									"description": "Maximum amount filter"
								},
								{
									"key": "userId",
									"value": "64abc123def456789012abcd",
									"description": "Filter by specific user ID"
								}
							]
						},
						"description": "Get all system transactions with comprehensive filters (Admin only)"
					},
					"response": [
						{
							"name": "Success Response",
							"status": "OK",
							"code": 200,
							"body": "{\n  \"success\": true,\n  \"message\": \"Transactions fetched successfully\",\n  \"data\": [\n    {\n      \"_id\": \"64abc123...\",\n      \"transactionCode\": \"TXN-1234567890\",\n      \"type\": \"deposit\",\n      \"method\": \"payos\",\n      \"amount\": 100000,\n      \"balanceBefore\": 0,\n      \"balanceAfter\": 100000,\n      \"status\": \"completed\",\n      \"userId\": {\n        \"_id\": \"...\",\n        \"fullName\": \"Nguyen Van A\",\n        \"email\": \"user@example.com\",\n        \"phone\": \"0901234567\"\n      },\n      \"walletId\": {\n        \"_id\": \"...\",\n        \"balance\": 100000\n      },\n      \"createdAt\": \"2024-01-15T10:30:00.000Z\"\n    }\n  ],\n  \"pagination\": {\n    \"total\": 1500,\n    \"page\": 1,\n    \"limit\": 20,\n    \"totalPages\": 75,\n    \"hasNextPage\": true,\n    \"hasPrevPage\": false\n  }\n}"
						}
					]
				},
				{
					"name": "Get Transaction Summary",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/admin/transactions/summary?from=2024-01-01&to=2024-12-31",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "transactions", "summary"],
							"query": [
								{
									"key": "from",
									"value": "2024-01-01",
									"description": "Start date (default: 30 days ago)"
								},
								{
									"key": "to",
									"value": "2024-12-31",
									"description": "End date (default: today)"
								}
							]
						},
						"description": "Get aggregated transaction statistics with breakdown by type, method, status, and daily trend"
					},
					"response": [
						{
							"name": "Success Response",
							"status": "OK",
							"code": 200,
							"body": "{\n  \"success\": true,\n  \"message\": \"Transaction summary fetched successfully\",\n  \"data\": {\n    \"period\": {\n      \"from\": \"2024-01-01\",\n      \"to\": \"2024-12-31\"\n    },\n    \"overall\": {\n      \"totalTransactions\": 2500,\n      \"totalAmount\": 150000000,\n      \"avgAmount\": 60000\n    },\n    \"byType\": {\n      \"deposit\": { \"count\": 800, \"amount\": 80000000 },\n      \"payment\": { \"count\": 1500, \"amount\": 65000000 },\n      \"refund\": { \"count\": 200, \"amount\": 5000000 }\n    },\n    \"byMethod\": {\n      \"payos\": { \"count\": 800, \"amount\": 80000000 },\n      \"system\": { \"count\": 1700, \"amount\": 70000000 }\n    },\n    \"byStatus\": {\n      \"pending\": { \"count\": 50, \"amount\": 2000000 },\n      \"completed\": { \"count\": 2400, \"amount\": 145000000 },\n      \"failed\": { \"count\": 30, \"amount\": 2000000 },\n      \"cancelled\": { \"count\": 20, \"amount\": 1000000 }\n    },\n    \"dailyTrend\": [\n      { \"date\": \"2024-01-01\", \"count\": 25, \"totalAmount\": 1500000 },\n      { \"date\": \"2024-01-02\", \"count\": 30, \"totalAmount\": 1800000 }\n    ]\n  }\n}"
						}
					]
				},
				{
					"name": "Get Any Transaction by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/admin/transactions/:id",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "transactions", ":id"],
							"variable": [
								{
									"key": "id",
									"value": "64abc123def456789012abcd",
									"description": "Transaction ID (24-character hex string)"
								}
							]
						},
						"description": "Get any transaction detail by ID (Admin can see all transactions)"
					},
					"response": [
						{
							"name": "Success Response",
							"status": "OK",
							"code": 200,
							"body": "{\n  \"success\": true,\n  \"message\": \"Transaction fetched successfully\",\n  \"data\": {\n    \"transaction\": {\n      \"_id\": \"64abc123...\",\n      \"transactionCode\": \"TXN-1234567890\",\n      \"type\": \"payment\",\n      \"method\": \"system\",\n      \"amount\": 150000,\n      \"balanceBefore\": 500000,\n      \"balanceAfter\": 350000,\n      \"status\": \"completed\",\n      \"note\": \"Thanh toán dịch vụ\",\n      \"userId\": {\n        \"_id\": \"...\",\n        \"fullName\": \"Nguyen Van A\",\n        \"email\": \"user@example.com\",\n        \"phone\": \"0901234567\",\n        \"role\": \"customer\",\n        \"isBlocked\": false\n      },\n      \"walletId\": {\n        \"_id\": \"...\",\n        \"balance\": 350000,\n        \"totalDeposited\": 1000000,\n        \"totalSpent\": 650000\n      },\n      \"referenceId\": \"booking-12345\",\n      \"createdAt\": \"2024-01-15T10:30:00.000Z\"\n    }\n  }\n}"
						}
					]
				},
				{
					"name": "Export Transactions to CSV",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/admin/transactions/export?type=deposit&status=completed&from=2024-01-01&to=2024-12-31",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "transactions", "export"],
							"query": [
								{
									"key": "type",
									"value": "deposit",
									"description": "Filter by type (optional)"
								},
								{
									"key": "status",
									"value": "completed",
									"description": "Filter by status (optional)"
								},
								{
									"key": "from",
									"value": "2024-01-01",
									"description": "Start date (optional)"
								},
								{
									"key": "to",
									"value": "2024-12-31",
									"description": "End date (optional)"
								}
							]
						},
						"description": "Export transactions to CSV file. Maximum 10,000 records. Use filters to narrow results."
					},
					"response": [
						{
							"name": "Success - CSV Download",
							"status": "OK",
							"code": 200,
							"headers": [
								{
									"key": "Content-Type",
									"value": "text/csv; charset=utf-8"
								},
								{
									"key": "Content-Disposition",
									"value": "attachment; filename=transactions_export_2024-01-15.csv"
								}
							],
							"body": "transactionCode,type,method,amount,balanceBefore,balanceAfter,status,userName,userEmail,note,failureReason,referenceId,createdAt\nTXN-1234567890,deposit,payos,100000,0,100000,completed,Nguyen Van A,user@example.com,Nạp tiền,,,2024-01-15T10:30:00.000Z"
						},
						{
							"name": "Error - Too Many Records",
							"status": "Bad Request",
							"code": 400,
							"body": "{\n  \"success\": false,\n  \"error\": {\n    \"code\": \"BAD_REQUEST\",\n    \"message\": \"Too many records (max 10,000). Please apply filters to narrow results.\"\n  }\n}"
						}
					]
				}
			]
		}
	]
}
