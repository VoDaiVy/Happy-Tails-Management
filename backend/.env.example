# ========================================
# Happy Tails Management - Backend
# Environment Configuration Example
# ========================================
# Copy this file to .env and fill in your values

# ==================== Application ====================
NODE_ENV=development
PORT=5000

# ==================== MongoDB ====================
# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/happy_tails_db?retryWrites=true&w=majority

# ==================== JWT Authentication ====================
# Secret keys - Use strong random strings in production (minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters
JWT_REFRESH_SECRET=your_super_secret_refresh_key_minimum_32_characters

# Token expiration
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d
JWT_COOKIE_EXPIRE=7

# ==================== Security ====================
# Password hashing rounds (higher = more secure but slower)
BCRYPT_ROUNDS=12

# Account lockout settings
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=7200000

# ==================== Rate Limiting ====================
# Time window in milliseconds (15 minutes = 900000)
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# ==================== Email Configuration ====================
# SMTP settings (Gmail example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Sender information
EMAIL_FROM=Happy Tails <noreply@happytails.com>

# ==================== Frontend URL ====================
# Used for email links (verification, password reset)
FRONTEND_URL=http://localhost:5173

# ==================== Logging ====================
# Log level: ERROR, WARN, INFO, DEBUG
LOG_LEVEL=INFO
